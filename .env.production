# Use the existing production database's actual username and name
POSTGRES_DB=coredb
POSTGRES_USER=coreuser
# Separate account created for Grafana
GRAFANA_DB_USER=grafana_reader

# Replace the address before deployment
GRAFANA_ROOT_URL=https://balkan-ccds.duckdns.org/grafana

# Host containerd socket verified on balkan1, balkan2 and balkan3.
# The deployment mounts this into cAdvisor on each node.
CADVISOR_CONTAINERD_SOCKET=/run/containerd/containerd.sock
