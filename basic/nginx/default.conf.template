# Rendered at container start: ${DOMAIN} is replaced by envsubst.
# nginx variables (written with a dollar and lowercase names) are left untouched.

# Docker's embedded DNS. Upstreams are resolved at request time (see "set"
# below), so nginx starts even if a backend service is not deployed yet:
# that backend simply answers 502 until it exists.
resolver 127.0.0.11 valid=10s ipv6=off;

ssl_certificate     /etc/nginx/certs/fullchain.pem;
ssl_certificate_key /etc/nginx/certs/privkey.pem;
ssl_protocols       TLSv1.2 TLSv1.3;

# Moodle accepts uploads up to 100M (PHP_UPLOAD_MAX_FILESIZE of the image).
client_max_body_size 100M;

# HTTP: only the Let's Encrypt challenge, everything else goes to HTTPS.
server {
    listen 80 default_server;
    server_name _;

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

# Main domain: health page + /api compatibility with the previous Traefik route.
server {
    listen 443 ssl default_server;
    server_name ${DOMAIN};

    location /api/ {
        set $up_core http://core:5000;
        rewrite ^/api/(.*)$ /$1 break;
        proxy_pass $up_core;
        include /etc/nginx/proxy_params.conf;
    }

    location / {
        default_type text/plain;
        return 200 "balkan-ccds frontend OK\n";
    }
}

# Core app (stack app/coreprod, alias "core" on network frontend).
server {
    listen 443 ssl;
    server_name app.${DOMAIN};

    location / {
        set $up_core http://core:5000;
        proxy_pass $up_core;
        include /etc/nginx/proxy_params.conf;
    }
}

# Moodle (stack atenea, alias "atenea-moodle" on network frontend).
server {
    listen 443 ssl;
    server_name moodle.${DOMAIN};

    location / {
        set $up_moodle http://atenea-moodle:8080;
        proxy_pass $up_moodle;
        include /etc/nginx/proxy_params.conf;
    }
}

# Grafana (stack stats, alias "stats-grafana" on network frontend).
server {
    listen 443 ssl;
    server_name grafana.${DOMAIN};

    location / {
        set $up_grafana http://stats-grafana:3000;
        proxy_pass $up_grafana;
        include /etc/nginx/proxy_params.conf;
    }
}
