map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

ssl_certificate     /etc/nginx/certs/fullchain.pem;
ssl_certificate_key /etc/nginx/certs/privkey.pem;
ssl_protocols       TLSv1.2 TLSv1.3;

# Moodle accepts uploads up to 100M (PHP_UPLOAD_MAX_FILESIZE of the image).
client_max_body_size 100M;

# HTTP: only the Let's Encrypt challenge, everything else goes to HTTPS.
server {
    listen 80 default_server;
    server_name _;

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

# Main domain: health page + /api compatibility with the previous Traefik route.
server {
    listen 443 ssl default_server;
    server_name ${DOMAIN};

    location /api/ {
        set $up_core http://core:5000;
        rewrite ^/api/(.*)$ /$1 break;
        proxy_pass $up_core;
        include /etc/nginx/proxy_params.conf;
    }

    # Grafana (stack stats, service "grafana" -> DNS name "stats_grafana" on
    # network frontend). Grafana is configured to live under /grafana
    # (GF_SERVER_SERVE_FROM_SUB_PATH=true), so the path is passed unchanged.
    location = /grafana {
        return 301 /grafana/;
    }
    location /grafana/ {
        set $up_grafana http://stats_grafana:3000;
        proxy_pass $up_grafana;
        include /etc/nginx/proxy_params.conf;
        # Grafana Live uses WebSockets
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
    }

    location / {
        default_type text/plain;
        return 200 "balkan-ccds frontend OK\n";
    }
}

# Core app (stack coreprod, alias "core" on network frontend)
# and static files (Apache, alias "app-static" on network frontend).
server {
    listen 443 ssl;
    server_name app.${DOMAIN};

    location /static/ {
        set $up_static http://app-static:80;
        rewrite ^/static/(.*)$ /$1 break;
        proxy_pass $up_static;
        include /etc/nginx/proxy_params.conf;
    }

    location / {
        set $up_core http://core:5000;
        proxy_pass $up_core;
        include /etc/nginx/proxy_params.conf;
    }
}

# Moodle (stack atenea, alias "atenea-moodle" on network frontend).
server {
    listen 443 ssl;
    server_name moodle.${DOMAIN};

    location / {
        set $up_moodle http://atenea-moodle:8080;
        proxy_pass $up_moodle;
        include /etc/nginx/proxy_params.conf;
    }
}

# Old subdomain for Grafana: redirect to the path used by the team.
server {
    listen 443 ssl;
    server_name grafana.${DOMAIN};

    location / {
        return 301 https://${DOMAIN}/grafana/;
    }
}
